diff --git a/lib/src/sock.c b/lib/src/sock.c
index b126bc2..c1e44a9 100644
--- a/lib/src/sock.c
+++ b/lib/src/sock.c
@@ -9,6 +9,15 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_socket_set_nonblock(chiaki_socket_t sock, b
 	u_long nbio = nonblock ? 1 : 0;
 	if(ioctlsocket(sock, FIONBIO, &nbio) != NO_ERROR)
 		return CHIAKI_ERR_UNKNOWN;
+#elif defined(CHIAKI_TIZEN_WASM)
+	// Tizen Sockets Extension does not implement fcntl().
+	// Sockets are created with SOCK_NONBLOCK via the socket() wrapper in
+	// tizen_compat.h, so a request for nonblock is already satisfied and a
+	// request to switch back to blocking cannot be honored. Callers in
+	// chiaki always guard blocking-style reads with stop-pipe select, so
+	// treating this as success is safe in practice.
+	(void)sock;
+	(void)nonblock;
 #else
 	int flags = fcntl(sock, F_GETFL, 0);
 	if(flags == -1)
